{
  "id": "./",
  "name": "English Master",
  "short_name": "English Master",
  "description": "לימוד אנגלית עם חזרות חכמות, קריאה, סרטונים ותרגום בלחיצה",
  "lang": "he",
  "dir": "rtl",
  "start_url": "./?src=app",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#eef2f6",
  "theme_color": "#0f766e",
  "categories": [
    "education",
    "productivity"
  ],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "תרגול יומי",
      "short_name": "תרגול",
      "url": "./?go=daily",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "הוספת מילה",
      "short_name": "הוספה",
      "url": "./?go=add",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "שירים וסרטונים",
      "short_name": "סרטונים",
      "url": "./?go=songs",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": {
      "title": "share_title",
      "text": "share_text",
      "url": "share_url"
    },
    "enctype": "application/x-www-form-urlencoded"
  }
}
